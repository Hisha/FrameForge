<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>FrameForge.Core</RootNamespace>
    <AssemblyName>FrameForge.Core</AssemblyName>
    <!--
      FrameForge.Core is the WoW geometry/layout engine. It must stay free of any
      UI dependency so it can be reasoned about and tested on its own; do not add
      an Avalonia package reference here. FrameForge.Desktop depends on this
      project, never the other way round.
    -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Reuse FrameForge's existing PNG codec for deterministic export conversion. -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
    <!-- Pure-managed, cross-platform BC3/DXT5 compression for WoW BLP2 export. -->
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
  </ItemGroup>

</Project>
