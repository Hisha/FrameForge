<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FrameForge.Desktop.ViewModels"
    xmlns:controls="using:FrameForge.Desktop.Controls"
    mc:Ignorable="d"
    d:DesignWidth="1440"
    d:DesignHeight="880"
    x:Class="FrameForge.Desktop.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    Title="{Binding WindowTitle}"
    Width="1440"
    Height="880"
    MinWidth="1000"
    MinHeight="640"
    WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#8FA3B0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.value">
            <Setter Property="Foreground" Value="#DCE7EE" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#11181E" />
            <Setter Property="BorderBrush" Value="#22303A" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TextBlock.header">
            <Setter Property="Foreground" Value="#7FB2C9" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="Consolas,Menlo,DejaVu Sans Mono,monospace" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#9FB4C1" />
        </Style>
    </Window.Styles>

    <!--
      The root grid is named so the smoke test can render the WHOLE window and compare it against a
      render with the canvas hidden. That is the only way to prove the canvas does not paint over
      its neighbours: asserting on a bitmap of the canvas alone can never observe an escape.
    -->
    <Grid x:Name="RootGrid" RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Toolbar: project lifecycle plus the two layout actions that have no obvious home. -->
        <Border Grid.Row="0" Background="#0D141A" BorderBrush="#22303A" BorderThickness="0,0,0,1" Padding="10,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="New" Click="OnNewClick" ToolTip.Tip="Start an empty project" />
                <Button Content="Open" Click="OnOpenClick"
                        ToolTip.Tip="Open a .fforge.json project or a WoW FrameXML file" />
                <Button Content="Save" Click="OnSaveClick" ToolTip.Tip="Save to the current file" />
                <Button Content="Save As" Click="OnSaveAsClick" ToolTip.Tip="Save to a new file" />

                <Rectangle Width="1" Fill="#22303A" Margin="4,2" />

                <Button Content="Load Native Hunts Example" Click="OnLoadExampleClick"
                        ToolTip.Tip="Load the built-in example layout" />
                <Button Content="Add Frame" Click="OnAddFrameClick" />
                <Button Content="Delete Frame" Click="OnDeleteFrameClick" />
                <Button Content="Fit" Click="OnFitClick" ToolTip.Tip="Frame the whole layout in the canvas" />

                <Rectangle Width="1" Fill="#22303A" Margin="4,2" />
                <Expander Header="{Binding AssetRootsSummary}" VerticalAlignment="Center">
                    <Border Background="#141B22" BorderBrush="#33434E" BorderThickness="1"
                            CornerRadius="4" Padding="8" MinWidth="360">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="label" Text="Machine-local roots, searched after source-relative assets" />
                            <ItemsControl ItemsSource="{Binding AssetRoots}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                            <TextBlock Grid.Column="0" Classes="mono" Text="{Binding}"
                                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding}" />
                                            <Button Grid.Column="1" Content="Remove" Tag="{Binding}"
                                                    Click="OnRemoveAssetRootClick" Margin="8,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Add / Browse" Click="OnAddAssetRootClick" />
                                <Button Content="Refresh Assets" Click="OnRefreshAssetsClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Expander>

                <Expander Header="WoW Client" VerticalAlignment="Center">
                    <Border Background="#141B22" BorderBrush="#33434E" BorderThickness="1"
                            CornerRadius="4" Padding="8" MinWidth="440">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="header" Text="Local WoW 3.3.5a client" />
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Client path" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Classes="mono" Text="{Binding WoWClientPath}"
                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding WoWClientPath}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Version/build" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding WoWClientVersion}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Locale" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Classes="value" Text="{Binding WoWClientLocale}" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="Status" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Classes="value" Text="{Binding WoWClientStatus}"
                                           TextWrapping="Wrap" />
                            </Grid>
                            <TextBlock Classes="mono" Text="{Binding StockAssetsSummary}" />
                            <TextBlock Classes="mono" Text="{Binding StockDefinitionsSummary}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Browse…" Click="OnBrowseWoWClientClick" />
                                <Button Content="Clear" Click="OnClearWoWClientClick"
                                        IsEnabled="{Binding HasWoWClientSelection}" />
                                <Button Content="Revalidate" Click="OnRevalidateWoWClientClick"
                                        IsEnabled="{Binding HasWoWClientSelection}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Resolve Missing Assets" Click="OnResolveStockAssetsClick"
                                        IsEnabled="{Binding CanResolveStockAssets}" />
                                <Button Content="Clear Stock Cache" Click="OnClearStockCacheClick" />
                            </StackPanel>
                            <TextBlock Classes="label" Text="Reads client MPQs without modifying them; preview copies stay local." />
                        </StackPanel>
                    </Border>
                </Expander>
            </StackPanel>
        </Border>

        <!-- Import banner: the origin of the layout, and what the importer could not honour.
             Row 1 collapses to nothing for projects authored in FrameForge, so this is only
             visible when there is genuinely a read-only external source to account for. -->
        <Border Grid.Row="1" IsVisible="{Binding HasSource}"
                Background="#141C15" BorderBrush="#2F4636" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" Classes="header" Text="IMPORTED" Margin="0,0,8,0"
                               VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Source.Headline}" TextWrapping="Wrap" />
                        <TextBlock Classes="mono" Text="{Binding Source.Detail}" TextWrapping="Wrap"
                                   Opacity="0.8" Margin="0,2,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Classes="mono" Margin="12,0,0,0" VerticalAlignment="Top"
                               Text="{Binding Source.SourcePath}" TextTrimming="CharacterEllipsis"
                               MaxWidth="320" ToolTip.Tip="{Binding Source.SourcePath}" />
                </Grid>

                <!-- Diagnostics are shown whether or not the import produced errors: a file that
                     imported "successfully" with fourteen warnings is not a clean file, and a
                     banner that stayed silent would imply otherwise. -->
                <Expander IsVisible="{Binding HasImportDiagnostics}" Header="{Binding Source.DiagnosticsHeader}">
                    <ItemsControl ItemsSource="{Binding ImportDiagnostics}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,0,0,3">
                                    <TextBlock Grid.Column="0" Margin="0,0,6,0" MinWidth="62"
                                               Text="{Binding Severity}" />
                                    <TextBlock Grid.Column="1" Classes="mono" Margin="0,0,6,0"
                                               Text="{Binding Heading}" Opacity="0.85" />
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </StackPanel>
        </Border>

        <!--
          View controls. Row 2 sits directly under the import banner and above the canvas, because
          these govern how the canvas draws rather than what the document contains: switching mode
          or a category is a change of view, never an edit, so nothing here marks the project dirty.
        -->
        <Border Grid.Row="2" Background="#0B1116" BorderBrush="#22303A" BorderThickness="0,0,0,1" Padding="10,6">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Classes="label" Text="View" VerticalAlignment="Center" />

                <!-- A RadioButton group rather than a ComboBox: the three modes are mutually
                     exclusive and are the most-used control in the window, so they should cost one
                     click rather than two, and should be able to show each mode's description. -->
                <ItemsControl ItemsSource="{Binding ModeOptions}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:CanvasModeOption">
                            <RadioButton GroupName="CanvasMode" Margin="0,0,2,0"
                                         Content="{Binding Label}"
                                         ToolTip.Tip="{Binding Description}"
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Rectangle Width="1" Fill="#22303A" Margin="4,2" />

                <TextBlock Classes="label" Text="Show" VerticalAlignment="Center" />

                <!-- One checkbox per category. Turning a category off removes those widgets from
                     drawing AND from picking, so the toggle cannot appear to do nothing until the
                     user happens to click where the widget used to be. -->
                <ItemsControl ItemsSource="{Binding VisibilityToggles}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:VisibilityToggle">
                            <CheckBox Content="{Binding Label}" ToolTip.Tip="{Binding ToolTip}"
                                      IsChecked="{Binding IsOn, Mode=TwoWay}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Rectangle Width="1" Fill="#22303A" Margin="4,2" />

                <TextBlock Classes="label" Text="Labels" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding LabelPolicyOptions}"
                          SelectedItem="{Binding SelectedLabelPolicyOption, Mode=TwoWay}"
                          DisplayMemberBinding="{Binding Label}"
                          ToolTip.Tip="Which widgets get a name label on the canvas" />

                <Button Content="Reset" Click="OnResetViewClick"
                        ToolTip.Tip="Restore this mode's default visibility and label settings" />
            </StackPanel>
        </Border>

        <!-- Row 3 is the only star row: the toolbar, view controls and import banner size to their
             content above it and the status bar sits below it, so this cell is exactly the canvas's
             allotment. -->
        <Grid x:Name="ContentRow" Grid.Row="3" ColumnDefinitions="260,* ,320">

            <!-- Frame tree -->
            <Border Grid.Column="0" Classes="panel" BorderThickness="0,0,1,0" Padding="10">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
                        <TextBlock Classes="header" Text="FRAMES" Margin="0" />

                        <!-- Search and structural filter only decide what the tree DISPLAYS. The
                             projection is recomputed from the project on every keystroke, so
                             filtering can never delete a widget and clearing the box restores the
                             full hierarchy. Ancestors of a match are always kept, so a search result
                             is never stranded under a collapsed parent. -->
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Text="{Binding TreeSearch, Mode=TwoWay}"
                                     PlaceholderText="Search frame names"
                                     ToolTip.Tip="Case-insensitive substring match on frame names" />
                            <Button Grid.Column="1" Content="Reveal" Margin="6,0,0,0"
                                    Click="OnRevealSelectionClick"
                                    ToolTip.Tip="Center the selected widget without changing zoom" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding TreeFilterOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:TreeFilterOption">
                                    <RadioButton GroupName="TreeFilter" Content="{Binding Label}"
                                                 IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Classes="mono" Text="{Binding TreeFilterSummary}" Opacity="0.7" />
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Bottom" Classes="mono" Text="{Binding ProjectDescription}"
                               TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TreeView x:Name="FrameTree"
                              SelectionMode="Single"
                              ItemsSource="{Binding TreeRoots}"
                              SelectedItem="{Binding SelectedTreeNode, Mode=TwoWay}">
                        <TreeView.Styles>
                            <Style Selector="TreeViewItem">
                                <Setter Property="IsExpanded" Value="True" />
                            </Style>
                        </TreeView.Styles>
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate DataType="vm:FrameTreeNode" ItemsSource="{Binding Children}">
                                <Grid ColumnDefinitions="Auto,*,Auto" MinWidth="180">
                                    <!-- The kind and the "fills" tag are what distinguish a
                                         FontString from a Texture from a Frame. Importing 51
                                         widgets that all look like identical panels tells the
                                         user nothing about the file they just opened. -->
                                    <Border Grid.Column="0" Classes="mono" Margin="0,0,6,0"
                                            Padding="4,1" CornerRadius="3" VerticalAlignment="Center"
                                            Background="#1C2733">
                                        <TextBlock Text="{Binding KindBadge}" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" Classes="mono"
                                               VerticalAlignment="Center" Opacity="0.75" />
                                </Grid>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- Preview canvas -->
            <Border Grid.Column="1" Background="#0C1116">
                <controls:LayoutCanvas x:Name="Canvas"
                                       SelectionRequested="OnCanvasSelectionRequested"
                                       FrameDragged="OnCanvasFrameDragged"
                                       DragCompleted="OnCanvasDragCompleted"
                                       FitRequested="OnCanvasFitRequested" />
            </Border>

            <!-- Inspector -->
            <Border Grid.Column="2" Classes="panel" BorderThickness="1,0,0,0" Padding="12">
                <ScrollViewer>
                    <StackPanel Spacing="6" IsEnabled="{Binding CanEditSelection}">
                        <TextBlock Classes="header" Text="INSPECTOR" />

                        <!-- Provenance, above the editable fields and outside their enabled state:
                             it describes the source, so it stays true while the fields below are
                             read-only because the frame belongs to an imported document. -->
                        <Border Background="#151B21" CornerRadius="4" Padding="8,6" Margin="0,0,0,8"
                                IsVisible="{Binding Editor.SourceNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Classes="mono" TextWrapping="Wrap"
                                       Text="{Binding Editor.SourceNote}" Opacity="0.85" />
                        </Border>

                        <Grid ColumnDefinitions="96,*">
                            <TextBlock Grid.Column="0" Classes="label" Text="Name" />
                            <TextBox Grid.Column="1" Text="{Binding Editor.Name, Mode=TwoWay}" Margin="4,0,0,4" />
                        </Grid>

                        <Grid ColumnDefinitions="96,*">
                            <TextBlock Grid.Column="0" Classes="label" Text="Parent" />
                            <ComboBox Grid.Column="1" Margin="4,0,0,4"
                                      ItemsSource="{Binding Editor.FrameOptions}"
                                      SelectedItem="{Binding Editor.Parent, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnDefinitions="96,*">
                            <TextBlock Grid.Column="0" Classes="label" Text="Width" />
                            <TextBox Grid.Column="1" Margin="4,0,0,4" Text="{Binding Editor.Width, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnDefinitions="96,*">
                            <TextBlock Grid.Column="0" Classes="label" Text="Height" />
                            <TextBox Grid.Column="1" Margin="4,0,0,4" Text="{Binding Editor.Height, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnDefinitions="96,*">
                            <TextBlock Grid.Column="0" Classes="label" Text="Size ref" />
                            <ComboBox Grid.Column="1" Margin="4,0,0,4"
                                      ItemsSource="{Binding Editor.SizeReferenceOptions}"
                                      SelectedItem="{Binding Editor.SizeReference, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnDefinitions="96,*">
                            <TextBlock Grid.Column="0" Classes="label" Text="Point" />
                            <ComboBox Grid.Column="1" Margin="4,0,0,4"
                                      ItemsSource="{Binding Editor.AnchorOptions}"
                                      SelectedItem="{Binding Editor.Point, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnDefinitions="96,*">
                            <TextBlock Grid.Column="0" Classes="label" Text="Relative to" />
                            <ComboBox Grid.Column="1" Margin="4,0,0,4"
                                      ItemsSource="{Binding Editor.FrameOptions}"
                                      SelectedItem="{Binding Editor.RelativeTo, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnDefinitions="96,*">
                            <TextBlock Grid.Column="0" Classes="label" Text="Relative pt" />
                            <ComboBox Grid.Column="1" Margin="4,0,0,4"
                                      ItemsSource="{Binding Editor.AnchorOptions}"
                                      SelectedItem="{Binding Editor.RelativePoint, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnDefinitions="96,*">
                            <TextBlock Grid.Column="0" Classes="label" Text="Offset X" />
                            <TextBox Grid.Column="1" Margin="4,0,0,4" Text="{Binding Editor.OffsetX, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnDefinitions="96,*">
                            <TextBlock Grid.Column="0" Classes="label" Text="Offset Y" />
                            <TextBox Grid.Column="1" Margin="4,0,0,4" Text="{Binding Editor.OffsetY, Mode=TwoWay}" />
                        </Grid>

                        <CheckBox Margin="4,4,0,4" Content="Visible" IsChecked="{Binding Editor.IsVisible, Mode=TwoWay}" />

                        <TextBlock Classes="header" Text="RESOLVED GEOMETRY" Margin="0,12,0,4" />
                        <TextBlock Classes="mono" Text="{Binding Editor.ResolvedSummary}" TextWrapping="Wrap" />

                        <!-- Extra anchors are shown, not editable. WoW applies several anchors
                             together and FrameForge will not rewrite one blind, so displaying them
                             is the honest option; hiding them would lose the only record of what
                             the source actually asked for. -->
                        <StackPanel IsVisible="{Binding Editor.HasExtraAnchors}" Margin="0,10,0,0">
                            <TextBlock Classes="header" Text="ADDITIONAL ANCHORS (READ-ONLY)" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding Editor.ExtraAnchors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:AnchorLine">
                                        <Border BorderBrush="#22303A" BorderThickness="1" CornerRadius="3"
                                                Padding="6,4" Margin="0,0,0,4">
                                            <StackPanel Spacing="1">
                                                <TextBlock Classes="mono" Text="{Binding Label}" />
                                                <TextBlock Classes="mono" TextWrapping="Wrap"
                                                           Text="{Binding Point}" Opacity="0.9" />
                                                <TextBlock Classes="mono" TextWrapping="Wrap"
                                                           Text="{Binding Target}" Opacity="0.9" />
                                                <TextBlock Classes="mono" TextWrapping="Wrap"
                                                           Text="{Binding RelativePoint}" Opacity="0.9" />
                                                <TextBlock Classes="mono" TextWrapping="Wrap"
                                                           Text="{Binding Offsets}" Opacity="0.7" />
                                                <TextBlock Classes="mono" TextWrapping="Wrap"
                                                           Text="{Binding Note}" Opacity="0.7" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock Classes="mono" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="{Binding Editor.AnchorNote}" Foreground="#E06C6C"
                                   IsVisible="{Binding Editor.AnchorNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                        <!--
                            Retained visual metadata. Read-only on purpose, and stated as such:
                            FrameForge understands these values and can draw a stand-in for them, but
                            it does not decode the art, emulate the Blizzard fonts, or run the Lua
                            that assigns runtime text. Showing the declared values without claiming
                            more is the honest presentation - an inspector that rendered the texture
                            file as if it were the texture would be lying about what it can do.
                        -->
                        <StackPanel IsVisible="{Binding Editor.HasVisual}" Margin="0,14,0,0">
                            <TextBlock Classes="header" Text="DECLARED VISUALS (READ-ONLY)" Margin="0,0,0,4" />
                            <Border Background="#141B22" BorderBrush="#22303A" BorderThickness="1"
                                    CornerRadius="4" Padding="8,6">
                                <ItemsControl ItemsSource="{Binding Editor.VisualLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Classes="mono" Text="{Binding}" TextWrapping="Wrap"
                                                       Margin="0,1" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>

                        <TextBlock Classes="label" Margin="0,8,0,0" Text="WoW model units, +Y up" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Geometry diagnostics -->
        <Border Grid.Row="4" Background="#0D141A" BorderBrush="#22303A" BorderThickness="0,1,0,0" Padding="10,6">
            <StackPanel Spacing="2">
                <TextBlock Classes="value" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="mono" Text="{Binding SelectionSummary}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
