<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FrameForge.Desktop.ViewModels"
    xmlns:controls="using:FrameForge.Desktop.Controls"
    mc:Ignorable="d"
    d:DesignWidth="1440"
    d:DesignHeight="880"
    x:Class="FrameForge.Desktop.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    Title="{Binding WindowTitle}"
    Icon="/Assets/Branding/frameforge-icon.png"
    Width="1440"
    Height="880"
    MinWidth="1000"
    MinHeight="640"
    WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#8FA3B0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.value">
            <Setter Property="Foreground" Value="#DCE7EE" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#11181E" />
            <Setter Property="BorderBrush" Value="#22303A" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TextBlock.header">
            <Setter Property="Foreground" Value="#7FB2C9" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="Consolas,Menlo,DejaVu Sans Mono,monospace" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#9FB4C1" />
        </Style>
    </Window.Styles>

    <!--
      The root grid is named so the smoke test can render the WHOLE window and compare it against a
      render with the canvas hidden. That is the only way to prove the canvas does not paint over
      its neighbours: asserting on a bitmap of the canvas alone can never observe an escape.
    -->
    <Grid x:Name="RootGrid" RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Toolbar: project lifecycle plus the two layout actions that have no obvious home. -->
        <Border Grid.Row="0" Background="#0D141A" BorderBrush="#22303A" BorderThickness="0,0,0,1" Padding="10,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="New" ToolTip.Tip="Start a blank project or a client-resolved Blizzard framework">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="FrameForge 2.0 Semantic Project" Click="OnNewV2Click" />
                            <Separator />
                            <MenuItem Header="Blank FrameForge Project" Click="OnNewClick" />
                            <MenuItem Header="Blizzard UI  ›  Dungeon Finder / LFD" Click="OnNewLfdClick" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button Content="Open" Click="OnOpenClick"
                        ToolTip.Tip="Open a .fforge.json project or a WoW FrameXML file" />
                <Button Content="Save" Click="OnSaveClick" ToolTip.Tip="Save to the current file" />
                <Button Content="Save As" Click="OnSaveAsClick" ToolTip.Tip="Save to a new file" />

                <Button Content="Export" ToolTip.Tip="Export presentation and runtime contracts"
                        IsEnabled="{Binding IsV1Project}">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Static WoW 3.3.5a Layout Package…" Click="OnExportWow335Click" />
                            <Separator />
                            <MenuItem Header="Associate Functional FrameXML…" Click="OnAssociateFunctionalFrameXmlClick" />
                            <MenuItem Header="Functional WoW 3.3.5a Interface Package…"
                                      IsEnabled="{Binding CanExportFunctionalDesign}"
                                      Click="OnExportFunctionalDesignClick" />
                            <Separator />
                            <MenuItem Header="Export Layout Changes…"
                                      IsEnabled="{Binding CanExportLayoutChanges}"
                                      Click="OnExportLayoutChangesClick" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <Rectangle Width="1" Fill="#22303A" Margin="4,2" />

                <Button Content="Add Frame" Click="OnAddFrameClick" IsVisible="{Binding IsV1Project}" />
                <Button Content="Add v2 Control" IsVisible="{Binding IsV2Project}"
                        ToolTip.Tip="Create a parent-anchored control under the selected valid container or composition root">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Frame" Click="OnAddV2FrameClick" />
                            <MenuItem Header="Texture" Click="OnAddV2TextureClick" />
                            <MenuItem Header="FontString" Click="OnAddV2FontStringClick" />
                            <MenuItem Header="Button" Click="OnAddV2ButtonClick" />
                            <MenuItem Header="StatusBar" Click="OnAddV2StatusBarClick" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button Content="Delete Frame" Click="OnDeleteFrameClick" />
                <Button Content="Fit" Click="OnFitClick" ToolTip.Tip="Frame the whole layout in the canvas" />

                <Rectangle Width="1" Fill="#22303A" Margin="4,2" />
                <Expander Header="WoW Client" VerticalAlignment="Center">
                    <Border Background="#141B22" BorderBrush="#33434E" BorderThickness="1"
                            CornerRadius="4" Padding="8" MinWidth="440">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="header" Text="Local WoW 3.3.5a client" />
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Client path" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Classes="mono" Text="{Binding WoWClientPath}"
                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding WoWClientPath}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Version/build" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding WoWClientVersion}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Locale" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Classes="value" Text="{Binding WoWClientLocale}" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="Status" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Classes="value" Text="{Binding WoWClientStatus}"
                                           TextWrapping="Wrap" />
                            </Grid>
                            <TextBlock Classes="mono" Text="{Binding StockAssetsSummary}" />
                            <TextBlock Classes="mono" Text="{Binding StockDefinitionsSummary}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Browse…" Click="OnBrowseWoWClientClick" />
                                <Button Content="Clear" Click="OnClearWoWClientClick"
                                        IsEnabled="{Binding HasWoWClientSelection}" />
                                <Button Content="Revalidate" Click="OnRevalidateWoWClientClick"
                                        IsEnabled="{Binding HasWoWClientSelection}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Resolve Missing Assets" Click="OnResolveStockAssetsClick"
                                        IsEnabled="{Binding CanResolveStockAssets}" />
                                <Button Content="Clear Stock Cache" Click="OnClearStockCacheClick" />
                                <Button Content="Refresh Asset Caches" Click="OnRefreshAssetsClick" />
                            </StackPanel>
                            <TextBlock Classes="label" Text="Reads client MPQs without modifying them; preview copies stay local." />
                        </StackPanel>
                    </Border>
                </Expander>
            </StackPanel>
        </Border>

        <!-- Import banner: the origin of the layout, and what the importer could not honour.
             Row 1 collapses to nothing for projects authored in FrameForge, so this is only
             visible when there is genuinely a read-only external source to account for. -->
        <Border Grid.Row="1" IsVisible="{Binding HasSource}"
                Background="#141C15" BorderBrush="#2F4636" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" Classes="header" Text="IMPORTED" Margin="0,0,8,0"
                               VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Source.Headline}" TextWrapping="Wrap" />
                        <TextBlock Classes="mono" Text="{Binding Source.Detail}" TextWrapping="Wrap"
                                   Opacity="0.8" Margin="0,2,0,0" />
                        <TextBlock Classes="mono" Text="{Binding PreviewSimulationSummary}" TextWrapping="Wrap"
                                   Foreground="#E5B567" Margin="0,3,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Classes="mono" Margin="12,0,0,0" VerticalAlignment="Top"
                               Text="{Binding Source.SourcePath}" TextTrimming="CharacterEllipsis"
                               MaxWidth="320" ToolTip.Tip="{Binding Source.SourcePath}" />
                </Grid>

                <!-- Diagnostics are shown whether or not the import produced errors: a file that
                     imported "successfully" with fourteen warnings is not a clean file, and a
                     banner that stayed silent would imply otherwise. -->
                <Expander IsVisible="{Binding HasImportDiagnostics}" Header="{Binding Source.DiagnosticsHeader}">
                    <ItemsControl ItemsSource="{Binding ImportDiagnostics}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,0,0,3">
                                    <TextBlock Grid.Column="0" Margin="0,0,6,0" MinWidth="62"
                                               Text="{Binding Severity}" />
                                    <TextBlock Grid.Column="1" Classes="mono" Margin="0,0,6,0"
                                               Text="{Binding Heading}" Opacity="0.85" />
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
                <Expander IsVisible="{Binding HasLayoutExportDiagnostics}" Header="Layout export diagnostics">
                    <ItemsControl ItemsSource="{Binding LayoutExportDiagnostics}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </StackPanel>
        </Border>

        <!--
          View controls. Row 2 sits directly under the import banner and above the canvas, because
          these govern how the canvas draws rather than what the document contains: switching mode
          or a category is a change of view, never an edit, so nothing here marks the project dirty.
        -->
        <Border Grid.Row="2" Background="#0B1116" BorderBrush="#22303A" BorderThickness="0,0,0,1" Padding="10,6">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <ItemsControl ItemsSource="{Binding WorkspaceOptions}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:WorkspaceOption">
                            <RadioButton GroupName="Workspace" Content="{Binding Label}"
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Rectangle Width="1" Fill="#315268" Margin="4,2" />
                <TextBlock Classes="label" Text="View" VerticalAlignment="Center" />

                <!-- A RadioButton group rather than a ComboBox: the three modes are mutually
                     exclusive and are the most-used control in the window, so they should cost one
                     click rather than two, and should be able to show each mode's description. -->
                <ItemsControl ItemsSource="{Binding ModeOptions}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:CanvasModeOption">
                            <RadioButton GroupName="CanvasMode" Margin="0,0,2,0"
                                         Content="{Binding Label}"
                                         ToolTip.Tip="{Binding Description}"
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Rectangle Width="1" Fill="#22303A" Margin="4,2" />

                <Expander Header="Origins" VerticalAlignment="Center" IsVisible="{Binding IsInspectWorkspace}"
                          ToolTip.Tip="Editor presentation only; source visibility is unchanged">
                    <Border Background="#141B22" BorderBrush="#33434E" BorderThickness="1"
                            CornerRadius="4" Padding="8">
                        <ItemsControl ItemsSource="{Binding OriginVisibilityToggles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:OriginVisibilityToggle">
                                    <CheckBox Content="{Binding Label}" ToolTip.Tip="{Binding ToolTip}"
                                              IsChecked="{Binding IsOn, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Expander>

                <Rectangle Width="1" Fill="#22303A" Margin="4,2" />

                <TextBlock Classes="label" Text="Show" VerticalAlignment="Center" IsVisible="{Binding IsInspectWorkspace}" />

                <!-- One checkbox per category. Turning a category off removes those widgets from
                     drawing AND from picking, so the toggle cannot appear to do nothing until the
                     user happens to click where the widget used to be. -->
                <ItemsControl ItemsSource="{Binding VisibilityToggles}" VerticalAlignment="Center" IsVisible="{Binding IsInspectWorkspace}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:VisibilityToggle">
                            <CheckBox Content="{Binding Label}" ToolTip.Tip="{Binding ToolTip}"
                                      IsChecked="{Binding IsOn, Mode=TwoWay}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Rectangle Width="1" Fill="#22303A" Margin="4,2" />

                <TextBlock Classes="label" Text="Labels" VerticalAlignment="Center" IsVisible="{Binding IsInspectWorkspace}" />
                <ComboBox ItemsSource="{Binding LabelPolicyOptions}"
                          IsVisible="{Binding IsInspectWorkspace}"
                          SelectedItem="{Binding SelectedLabelPolicyOption, Mode=TwoWay}"
                          DisplayMemberBinding="{Binding Label}"
                          ToolTip.Tip="Which widgets get a name label on the canvas" />

                <Rectangle Width="1" Fill="#22303A" Margin="4,2" />
                <TextBlock Classes="label" Text="Imported preview" VerticalAlignment="Center" />
                <ComboBox x:Name="PreviewStateSelector"
                          MinWidth="132"
                          ItemsSource="{Binding PreviewStateOptions}"
                          SelectedItem="{Binding SelectedPreviewState, Mode=TwoWay}"
                          DisplayMemberBinding="{Binding Label}"
                          ToolTip.Tip="{Binding PreviewStateExplanation}" />

                <TextBlock Classes="label" Text="Design state" VerticalAlignment="Center" IsVisible="{Binding ShowV1DesignTools}" />
                <ComboBox MinWidth="132" IsVisible="{Binding ShowV1DesignTools}"
                          ItemsSource="{Binding DesignStateOptions}"
                          SelectedItem="{Binding ActiveDesignState, Mode=TwoWay}"
                          DisplayMemberBinding="{Binding Name}"
                          ToolTip.Tip="Lua-free authored composition state" />

                <Button Content="Reset" Click="OnResetViewClick"
                        ToolTip.Tip="Restore this mode's default visibility and label settings" />
            </StackPanel>
        </Border>

        <!-- Row 3 is the only star row: the toolbar, view controls and import banner size to their
             content above it and the status bar sits below it, so this cell is exactly the canvas's
             allotment. -->
        <Grid x:Name="ContentRow" Grid.Row="3" ColumnDefinitions="260,* ,320">

            <!-- Frame tree -->
            <Border Grid.Column="0" Classes="panel" BorderThickness="0,0,1,0" Padding="10">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
                        <TextBlock Classes="header" Text="OBJECTS" Margin="0" IsVisible="{Binding IsDesignWorkspace}" />
                        <TextBlock Classes="header" Text="FRAME HIERARCHY" Margin="0" IsVisible="{Binding IsInspectWorkspace}" />

                        <!-- Search and structural filter only decide what the tree DISPLAYS. The
                             projection is recomputed from the project on every keystroke, so
                             filtering can never delete a widget and clearing the box restores the
                             full hierarchy. Ancestors of a match are always kept, so a search result
                             is never stranded under a collapsed parent. -->
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Text="{Binding TreeSearch, Mode=TwoWay}"
                                     PlaceholderText="Search frame names"
                                     ToolTip.Tip="Case-insensitive substring match on frame names" />
                            <Button Grid.Column="1" Content="Reveal" Margin="6,0,0,0"
                                    Click="OnRevealSelectionClick"
                                    ToolTip.Tip="Center the selected widget without changing zoom" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding TreeFilterOptions}" IsVisible="{Binding IsInspectWorkspace}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:TreeFilterOption">
                                    <RadioButton GroupName="TreeFilter" Content="{Binding Label}"
                                                 IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Classes="mono" Text="{Binding TreeFilterSummary}" Opacity="0.7" IsVisible="{Binding IsInspectWorkspace}" />

                        <Expander Header="Add object" IsVisible="{Binding ShowV1DesignTools}" IsExpanded="True">
                            <StackPanel Spacing="5" Margin="0,6,0,0">
                                <TextBox Text="{Binding NewObjectName, Mode=TwoWay}" PlaceholderText="Object name" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
                                    <TextBox Grid.Column="0" Text="{Binding NewImageAsset, Mode=TwoWay}"
                                             PlaceholderText="Image / Asset (for Image)" />
                                    <Button Grid.Column="1" Content="Browse..." Click="OnBrowseNewDesignImageClick" />
                                </Grid>
                                <WrapPanel>
                                    <Button Content="Frame" Click="OnAddDesignFrameClick" Margin="0,0,4,4" />
                                    <Button Content="Text" Click="OnAddDesignTextClick" Margin="0,0,4,4" />
                                    <Button Content="Image" Click="OnAddDesignImageClick" Margin="0,0,4,4" />
                                    <Button Content="Status Bar" Click="OnAddDesignStatusBarClick" Margin="0,0,4,4" />
                                </WrapPanel>
                            </StackPanel>
                        </Expander>

                        <Expander Header="Add v2 semantic control" IsVisible="{Binding ShowV2DesignTools}" IsExpanded="True">
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="Frame" Click="OnAddV2FrameClick" Margin="0,0,4,4" />
                                <Button Content="Texture" Click="OnAddV2TextureClick" Margin="0,0,4,4" />
                                <Button Content="FontString" Click="OnAddV2FontStringClick" Margin="0,0,4,4" />
                                <Button Content="Button" Click="OnAddV2ButtonClick" Margin="0,0,4,4" />
                                <Button Content="StatusBar" Click="OnAddV2StatusBarClick" Margin="0,0,4,4" />
                            </WrapPanel>
                        </Expander>

                        <Expander Header="Design states" IsVisible="{Binding ShowV1DesignTools}">
                            <StackPanel Spacing="5" Margin="0,6,0,0">
                                <ComboBox ItemsSource="{Binding AuthoredStateOptions}"
                                          SelectedItem="{Binding SelectedAuthoredState, Mode=TwoWay}"
                                          DisplayMemberBinding="{Binding Name}" PlaceholderText="No authored states" />
                                <TextBox Text="{Binding StateNameDraft, Mode=TwoWay}" PlaceholderText="State name" />
                                <WrapPanel>
                                    <Button Content="Create" Click="OnCreateStateClick" Margin="0,0,4,4" />
                                    <Button Content="Rename" Click="OnRenameStateClick" Margin="0,0,4,4" />
                                    <Button Content="Delete" Click="OnDeleteStateClick" Margin="0,0,4,4" />
                                </WrapPanel>
                            </StackPanel>
                        </Expander>

                        <Expander Header="Editor groups" Margin="0,4,0,0" IsVisible="{Binding ShowV1InspectTools}">
                            <StackPanel Spacing="5" Margin="0,6,0,0">
                                <ComboBox ItemsSource="{Binding Groups}"
                                          SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                                          DisplayMemberBinding="{Binding Name}"
                                          PlaceholderText="No groups" />
                                <TextBox Text="{Binding GroupNameDraft, Mode=TwoWay}"
                                         PlaceholderText="Group name" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="Create" Click="OnCreateGroupClick" Margin="0,0,4,4" />
                                    <Button Content="Rename" Click="OnRenameGroupClick" Margin="0,0,4,4" />
                                    <Button Content="Delete" Click="OnDeleteGroupClick" Margin="0,0,4,4" />
                                </WrapPanel>
                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="Add selected" Click="OnAddSelectionToGroupClick" Margin="0,0,4,4" />
                                    <Button Content="Remove" Click="OnRemoveSelectionFromGroupClick" Margin="0,0,4,4" />
                                </WrapPanel>
                                <CheckBox Content="Lock group"
                                          IsChecked="{Binding SelectedGroupLocked, Mode=TwoWay}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Bottom" Classes="mono" Text="{Binding ProjectDescription}"
                               TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TreeView x:Name="FrameTree"
                              SelectionMode="Single"
                              AutoScrollToSelectedItem="True"
                              PointerPressed="OnFrameTreePointerPressed"
                              ItemsSource="{Binding TreeRoots}"
                              SelectedItem="{Binding SelectedTreeNode, Mode=TwoWay}">
                        <TreeView.Styles>
                            <Style Selector="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
                            </Style>
                        </TreeView.Styles>
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate DataType="vm:FrameTreeNode" ItemsSource="{Binding Children}">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" MinWidth="180"
                                      ToolTip.Tip="{Binding IdentitySummary}">
                                    <!-- The kind and the "fills" tag are what distinguish a
                                         FontString from a Texture from a Frame. Importing 51
                                         widgets that all look like identical panels tells the
                                         user nothing about the file they just opened. -->
                                    <Border Grid.Column="0" Classes="mono" Margin="0,0,6,0" IsVisible="{Binding $parent[Window].DataContext.IsInspectWorkspace}"
                                            Padding="4,1" CornerRadius="3" VerticalAlignment="Center"
                                            Background="#1C2733">
                                        <TextBlock Text="{Binding KindBadge}" />
                                    </Border>
                                    <!-- The TreeView highlights one row at a time, so the other
                                         members of a multi-selection need a marker of their own or
                                         a Ctrl+click would look like it did nothing. -->
                                    <TextBlock Grid.Column="1" Margin="0,0,5,0" VerticalAlignment="Center"
                                               IsVisible="{Binding ShowsSelectionBadge}"
                                               Text="{Binding SelectionBadge}"
                                               Foreground="#F2C14E" FontWeight="Bold" />
                                    <TextBlock Grid.Column="2" Text="{Binding DisplayName}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding LockBadge}" Margin="4,0" />
                                    <TextBlock Grid.Column="4" Text="{Binding GroupBadge}" Classes="mono" IsVisible="{Binding $parent[Window].DataContext.IsInspectWorkspace}"
                                               MaxWidth="70" TextTrimming="CharacterEllipsis" Opacity="0.75" />
                                    <TextBlock Grid.Column="5" Text="{Binding SizeText}" Classes="mono" IsVisible="{Binding $parent[Window].DataContext.IsInspectWorkspace}"
                                               VerticalAlignment="Center" Opacity="0.75" />
                                </Grid>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- Preview canvas -->
            <Border Grid.Column="1" Background="#0C1116">
                <controls:LayoutCanvas x:Name="Canvas"
                                       SelectionRequested="OnCanvasSelectionRequested"
                                       FrameDragged="OnCanvasFrameDragged"
                                       DragCompleted="OnCanvasDragCompleted"
                                       FitRequested="OnCanvasFitRequested" />
            </Border>

            <!-- Inspector -->
            <Border Grid.Column="2" Classes="panel" BorderThickness="1,0,0,0" Padding="12">
                <ScrollViewer>
                    <StackPanel Spacing="8">
                    <StackPanel Spacing="7" IsVisible="{Binding IsV2Project}">
                        <TextBlock Classes="header" Text="FRAMEFORGE 2.0 · SEMANTIC INSPECTOR" />
                        <TextBlock Classes="mono" Text="{Binding V2ProjectSummary}" TextWrapping="Wrap" />
                        <TextBlock Classes="mono" Text="{Binding V2RootSummary}" TextWrapping="Wrap" />
                        <Border Background="#14231A" BorderBrush="#315B40" BorderThickness="1" CornerRadius="4" Padding="7,5">
                            <StackPanel Spacing="3">
                                <TextBlock Classes="mono" Text="{Binding V2DiagnosticsSummary}" />
                                <ItemsControl ItemsSource="{Binding V2Diagnostics}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Classes="mono" Foreground="#E5796B" TextWrapping="Wrap"
                                                       Text="{Binding Message}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border IsVisible="{Binding IsV2RootSelected}" Background="#17212A" BorderBrush="#315268"
                                BorderThickness="1" CornerRadius="4" Padding="8,6">
                            <TextBlock Text="The required composition root is selected. Add a control to create it under this root; the root itself cannot be deleted."
                                       TextWrapping="Wrap" />
                        </Border>

                        <StackPanel IsVisible="{Binding HasV2NodeSelection}" Spacing="5">
                            <TextBlock Classes="header" Text="IDENTITY · OWNERSHIP" Margin="0,4,0,2" />
                            <TextBlock Classes="mono" Text="{Binding V2SelectedKind, StringFormat='Kind: {0}'}" />
                            <Grid ColumnDefinitions="92,*">
                                <TextBlock Grid.Column="0" Classes="label" Text="Display label" />
                                <TextBox Grid.Column="1" Text="{Binding V2DisplayLabelDraft, Mode=TwoWay}" />
                            </Grid>
                            <Grid ColumnDefinitions="92,*">
                                <TextBlock Grid.Column="0" Classes="label" Text="Runtime name" />
                                <TextBox Grid.Column="1" Text="{Binding V2RuntimeNameDraft, Mode=TwoWay}" />
                            </Grid>
                            <Grid ColumnDefinitions="92,*">
                                <TextBlock Grid.Column="0" Classes="label" Text="Owner" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding V2OwnerOptions}"
                                          SelectedItem="{Binding V2OwnerDraft, Mode=TwoWay}" />
                            </Grid>

                            <TextBlock Classes="header" Text="GEOMETRY · TYPED ANCHOR" Margin="0,8,0,2" />
                            <Grid ColumnDefinitions="92,*,8,92,*">
                                <TextBlock Grid.Column="0" Classes="label" Text="Width" />
                                <TextBox Grid.Column="1" Text="{Binding V2WidthDraft, Mode=TwoWay}" />
                                <TextBlock Grid.Column="3" Classes="label" Text="Height" />
                                <TextBox Grid.Column="4" Text="{Binding V2HeightDraft, Mode=TwoWay}" />
                            </Grid>
                            <Grid ColumnDefinitions="92,*,8,92,*">
                                <TextBlock Grid.Column="0" Classes="label" Text="Offset X" />
                                <TextBox Grid.Column="1" Text="{Binding V2OffsetXDraft, Mode=TwoWay}" />
                                <TextBlock Grid.Column="3" Classes="label" Text="Offset Y" />
                                <TextBox Grid.Column="4" Text="{Binding V2OffsetYDraft, Mode=TwoWay}" />
                            </Grid>
                            <Grid ColumnDefinitions="92,*">
                                <TextBlock Grid.Column="0" Classes="label" Text="Anchor target" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding V2AnchorTargetOptions}"
                                          SelectedItem="{Binding V2AnchorTargetDraft, Mode=TwoWay}" />
                            </Grid>
                            <Grid ColumnDefinitions="92,*">
                                <TextBlock Grid.Column="0" Classes="label" Text="Point" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding V2AnchorPoints}"
                                          SelectedItem="{Binding V2PointDraft, Mode=TwoWay}" />
                            </Grid>
                            <Grid ColumnDefinitions="92,*">
                                <TextBlock Grid.Column="0" Classes="label" Text="Relative point" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding V2AnchorPoints}"
                                          SelectedItem="{Binding V2RelativePointDraft, Mode=TwoWay}" />
                            </Grid>

                            <TextBlock Classes="header" Text="SUPPORTED APPEARANCE" Margin="0,8,0,2" />
                            <CheckBox IsVisible="{Binding V2IsFrameNode}" Content="Visible"
                                      IsChecked="{Binding V2VisibleDraft, Mode=TwoWay}" />
                            <StackPanel IsVisible="{Binding V2IsRegionNode}" Spacing="3">
                                <TextBlock Classes="label" Text="Tint · R,G,B[,A]" />
                                <TextBox Text="{Binding V2TintDraft, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel IsVisible="{Binding V2IsTexture}" Spacing="3">
                                <TextBlock Classes="label" Text="Texture reference" />
                                <TextBox Text="{Binding V2TextureDraft, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel IsVisible="{Binding V2IsFontString}" Spacing="3">
                                <TextBlock Classes="label" Text="Text" />
                                <TextBox Text="{Binding V2TextDraft, Mode=TwoWay}" />
                                <TextBlock Classes="label" Text="Font reference" />
                                <TextBox Text="{Binding V2FontDraft, Mode=TwoWay}" />
                            </StackPanel>
                            <CheckBox IsVisible="{Binding V2IsButton}" Content="Enabled"
                                      IsChecked="{Binding V2ButtonEnabledDraft, Mode=TwoWay}" />
                            <StackPanel IsVisible="{Binding V2IsStatusBar}" Spacing="3">
                                <Grid ColumnDefinitions="*,6,*,6,*">
                                    <TextBox Grid.Column="0" PlaceholderText="Minimum" Text="{Binding V2StatusMinimumDraft, Mode=TwoWay}" />
                                    <TextBox Grid.Column="2" PlaceholderText="Maximum" Text="{Binding V2StatusMaximumDraft, Mode=TwoWay}" />
                                    <TextBox Grid.Column="4" PlaceholderText="Value" Text="{Binding V2StatusValueDraft, Mode=TwoWay}" />
                                </Grid>
                                <TextBox PlaceholderText="Status texture reference" Text="{Binding V2StatusTextureDraft, Mode=TwoWay}" />
                            </StackPanel>

                            <TextBlock Classes="label" Foreground="#E5796B" Text="{Binding V2InspectorValidation}"
                                       TextWrapping="Wrap" />
                            <TextBlock Classes="label" Text="{Binding V2UnsupportedPropertiesNote}" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,5,0,0">
                                <Button Content="Apply" Click="OnApplyV2InspectorClick" Margin="0,0,5,5" />
                                <Button Content="Earlier" Click="OnMoveV2EarlierClick" Margin="0,0,5,5" />
                                <Button Content="Later" Click="OnMoveV2LaterClick" Margin="0,0,5,5" />
                                <Button Content="Delete" Click="OnDeleteV2Click" Margin="0,0,5,5" />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="6" IsVisible="{Binding IsV1Project}">
                        <TextBlock Classes="header" Text="DESIGN PROPERTIES" IsVisible="{Binding IsDesignWorkspace}" />
                        <TextBlock Classes="header" Text="INSPECTOR" IsVisible="{Binding IsInspectWorkspace}" />

                        <!-- Multi-selection. Kept above the single-object editors because during a
                             multi-selection those editors describe one object while the user is
                             acting on several, and the count has to be the first thing they read. -->
                        <Border Background="#1A232B" BorderBrush="#F2C14E" BorderThickness="1"
                                CornerRadius="4" Padding="8,6"
                                IsVisible="{Binding IsMultiSelection}">
                            <StackPanel Spacing="5">
                                <TextBlock Classes="label" Text="SELECTION"
                                           Foreground="#F2C14E" />
                                <TextBlock Text="{Binding MultiSelectionSummary}" TextWrapping="Wrap" />
                                <StackPanel IsVisible="{Binding IsDesignWorkspace}" Spacing="3">
                                    <TextBlock Classes="label" Text="ALIGN"
                                               ToolTip.Tip="Alignments use the bounds of the whole selection, locked objects included. They only ever add to OffsetsX/OffsetsY." />
                                    <WrapPanel>
                                        <Button Content="Left" Tag="AlignLeft" Click="OnArrangeClick"
                                                Margin="0,0,4,4" IsEnabled="{Binding CanAlignSelection}"
                                                ToolTip.Tip="Align the left edges of the selected objects." />
                                        <Button Content="Center H" Tag="AlignCenterHorizontal" Click="OnArrangeClick"
                                                Margin="0,0,4,4" IsEnabled="{Binding CanAlignSelection}"
                                                ToolTip.Tip="Align the horizontal centers of the selected objects." />
                                        <Button Content="Right" Tag="AlignRight" Click="OnArrangeClick"
                                                Margin="0,0,4,4" IsEnabled="{Binding CanAlignSelection}"
                                                ToolTip.Tip="Align the right edges of the selected objects." />
                                        <Button Content="Top" Tag="AlignTop" Click="OnArrangeClick"
                                                Margin="0,0,4,4" IsEnabled="{Binding CanAlignSelection}"
                                                ToolTip.Tip="Align the top edges of the selected objects." />
                                        <Button Content="Center V" Tag="AlignCenterVertical" Click="OnArrangeClick"
                                                Margin="0,0,4,4" IsEnabled="{Binding CanAlignSelection}"
                                                ToolTip.Tip="Align the vertical centers of the selected objects." />
                                        <Button Content="Bottom" Tag="AlignBottom" Click="OnArrangeClick"
                                                Margin="0,0,4,4" IsEnabled="{Binding CanAlignSelection}"
                                                ToolTip.Tip="Align the bottom edges of the selected objects." />
                                    </WrapPanel>
                                    <TextBlock Classes="label" Text="DISTRIBUTE"
                                               ToolTip.Tip="Distribution needs three objects. The outermost two stay put and the gaps between them become equal. It works only among the objects it may move." />
                                    <WrapPanel>
                                        <Button Content="Distribute H" Tag="DistributeHorizontal" Click="OnArrangeClick"
                                                Margin="0,0,4,4" IsEnabled="{Binding CanDistributeSelection}"
                                                ToolTip.Tip="Space the selected objects so the horizontal gaps between them are equal." />
                                        <Button Content="Distribute V" Tag="DistributeVertical" Click="OnArrangeClick"
                                                Margin="0,0,4,4" IsEnabled="{Binding CanDistributeSelection}"
                                                ToolTip.Tip="Space the selected objects so the vertical gaps between them are equal." />
                                    </WrapPanel>
                                    <TextBlock Classes="label"
                                               Text="Locked objects are reported and left alone. Frames whose size comes from SetAllPoints or several anchors are not moved."
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Classes="label"
                                           IsVisible="{Binding IsInspectWorkspace}"
                                           Text="INSPECTOR shows the primary object only. Multi-object editing belongs to DESIGN."
                                           TextWrapping="Wrap" />
                                <Button Content="Show only primary" Click="OnCollapseSelectionClick"
                                        HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <!-- State membership is a bulk decision, so it lives outside the
                             single-object editors: one selected object and a three-object
                             selection both get the same chooser, and Apply assigns the same
                             membership to every editable object in the selection. -->
                        <Border Background="#101D25" BorderBrush="#315268" BorderThickness="1"
                                CornerRadius="4" Padding="8,6" IsVisible="{Binding IsDesignWorkspace}">
                            <StackPanel Spacing="5">
                                <TextBlock Classes="label" Text="STATE MEMBERSHIP"
                                           ToolTip.Tip="All States means the object appears in every current design state and in states created later. Choosing specific states keeps it in exactly those states, and no others." />
                                <TextBlock Classes="value" Text="{Binding SelectedStateMembership}" TextWrapping="Wrap" />
                                <Button Content="Choose States..." Click="OnChooseStatesClick"
                                        HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <StackPanel IsVisible="{Binding ShowsSingleObjectEditors}">
                        <Border Background="#17232C" BorderBrush="#315268" BorderThickness="1"
                                CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="header" Text="SOURCE ANCHOR (AUTHORITATIVE / READ-ONLY)" />
                                <TextBlock Classes="mono" Text="{Binding SelectedSourceAnchor}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Background="#101D25" BorderBrush="#315268" BorderThickness="1"
                                CornerRadius="4" Padding="8,6" IsVisible="{Binding IsDesignWorkspace}">
                            <StackPanel Spacing="5">
                                <TextBlock Classes="label" Text="NAME" />
                                <!-- A locked element is selectable for reference only: no authoring
                                     fields, no rename, no partial DESIGN object editor. -->
                                <Border Background="#2A1418" BorderBrush="#B0533F" BorderThickness="1"
                                        CornerRadius="4" Padding="8,5" IsVisible="{Binding IsSelectionLocked}">
                                    <TextBlock Classes="value" TextWrapping="Wrap"
                                               Text="{Binding DesignLockedSummary}" />
                                </Border>
                                <TextBox Text="{Binding DesignNameDraft, Mode=TwoWay}"
                                         IsEnabled="{Binding CanEditSelection}" />
                                <StackPanel IsVisible="{Binding IsDesignTextSelected}" Spacing="3" Margin="0,5,0,0">
                                    <TextBlock Classes="label" Text="TEXT" />
                                    <TextBox Text="{Binding DesignTextDraft, Mode=OneWay}"
                                             TextChanged="OnDesignTextChanged" />
                                    <TextBlock Classes="label" Text="WOW TEXT STYLE" Margin="0,5,0,0" />
                                    <ComboBox ItemsSource="{Binding TextStyleOptions}"
                                              SelectedItem="{Binding SelectedTextStyle, Mode=TwoWay}"
                                              IsEnabled="{Binding CanEditTextStyle}" />
                                    <TextBlock Classes="label" Text="WoW 3.3.5a client fonts only · no font files are embedded in the project."
                                               TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="72,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,3,0,0">
                                        <TextBlock Grid.Row="0" Classes="label" Text="Font" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Classes="mono" Text="{Binding SelectedTextFont}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="1" Classes="label" Text="Effective" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Classes="mono"
                                                   Text="{Binding SelectedTextEffectiveSize, StringFormat='Size: {0}'}" />
                                        <TextBlock Grid.Row="2" Classes="label" Text="Color" />
                                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                            <Border Width="20" Height="14" BorderBrush="#8FA6B4" BorderThickness="1"
                                                    Background="{Binding SelectedTextColorSwatch}" />
                                            <TextBlock Classes="mono" Text="{Binding SelectedTextEffectiveColor}" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="3" Classes="label" Text="Outline" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Classes="mono" Text="{Binding SelectedTextEffectiveOutline}" />
                                        <TextBlock Grid.Row="4" Classes="label" Text="Shadow" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Classes="mono" Text="{Binding SelectedTextEffectiveShadow}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="5" Classes="label" Text="Align" />
                                        <TextBlock Grid.Row="5" Grid.Column="1" Classes="mono" Text="{Binding SelectedTextEffectiveAlignment}" />
                                    </Grid>
                                    <StackPanel IsEnabled="{Binding CanEditTextStyle}" Spacing="3">
                                        <Grid ColumnDefinitions="72,*">
                                            <TextBlock Classes="label" Text="Size" />
                                            <TextBox Grid.Column="1" Text="{Binding TextStyleSizeDraft, Mode=TwoWay}"
                                                     Tag="textStyleSize" KeyDown="OnTextStyleFieldKeyDown" LostFocus="OnTextStyleFieldLostFocus" />
                                        </Grid>
                                        <Grid ColumnDefinitions="72,*">
                                            <TextBlock Classes="label" Text="RGBA" />
                                            <TextBox Grid.Column="1" Text="{Binding TextStyleColorDraft, Mode=TwoWay}"
                                                     Tag="textStyleColor" KeyDown="OnTextStyleFieldKeyDown" LostFocus="OnTextStyleFieldLostFocus" />
                                        </Grid>
                                        <Grid ColumnDefinitions="72,*"><TextBlock Classes="label" Text="Outline" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding TextOutlineOptions}" SelectedItem="{Binding SelectedTextOutline, Mode=TwoWay}" /></Grid>
                                        <Grid ColumnDefinitions="72,*"><TextBlock Classes="label" Text="Shadow" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding TextShadowOptions}" SelectedItem="{Binding SelectedTextShadow, Mode=TwoWay}" /></Grid>
                                        <Grid ColumnDefinitions="72,*"><TextBlock Classes="label" Text="Align" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding TextAlignmentOptions}" SelectedItem="{Binding SelectedTextAlignment, Mode=TwoWay}" /></Grid>
                                        <TextBlock Classes="validation" Text="{Binding TextStyleValidation}" TextWrapping="Wrap" />
                                        <Button Content="Reset overrides to style" Click="OnResetTextStyleClick" HorizontalAlignment="Left" />
                                    </StackPanel>
                                    <WrapPanel Margin="0,3,0,0">
                                        <Button Content="Copy Text Style" Click="OnCopyTextStyleClick" Margin="0,0,4,4" />
                                        <Button Content="Paste Text Style" Click="OnPasteTextStyleClick" IsEnabled="{Binding CanPasteTextStyle}" Margin="0,0,4,4" />
                                    </WrapPanel>
                                </StackPanel>
                                <StackPanel IsVisible="{Binding IsDesignImageSelected}" Spacing="3" Margin="0,5,0,0">
                                    <TextBlock Classes="label" Text="IMAGE / ASSET" />
                                    <TextBlock Classes="mono" Text="{Binding SelectedDesignAssetReference}"
                                               TextWrapping="Wrap" />
                                    <Button Content="Browse / Change..." HorizontalAlignment="Left"
                                            Click="OnChangeDesignImageClick" />
                                </StackPanel>
                                <StackPanel IsVisible="{Binding IsDesignStatusBarSelected}" Spacing="3" Margin="0,5,0,0">
                                    <TextBlock Classes="label" Text="STATUS BAR" />
                                    <TextBlock Text="{Binding SelectedStatusBarFractionText}" TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="72,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="4">
                                        <TextBlock Grid.Row="0" Classes="label" Text="Min" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding StatusBarMinDraft, Mode=TwoWay}"
                                                 Tag="statusBarMin" IsEnabled="{Binding CanEditDesignStatusBar}"
                                                 KeyDown="OnStatusBarFieldKeyDown" LostFocus="OnStatusBarFieldLostFocus" />
                                        <TextBlock Grid.Row="1" Classes="label" Text="Max" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding StatusBarMaxDraft, Mode=TwoWay}"
                                                 Tag="statusBarMax" IsEnabled="{Binding CanEditDesignStatusBar}"
                                                 KeyDown="OnStatusBarFieldKeyDown" LostFocus="OnStatusBarFieldLostFocus" />
                                        <TextBlock Grid.Row="2" Classes="label" Text="Preview Value" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding StatusBarValueDraft, Mode=TwoWay}"
                                                 Tag="statusBarValue" IsEnabled="{Binding CanEditDesignStatusBar}"
                                                 KeyDown="OnStatusBarFieldKeyDown" LostFocus="OnStatusBarFieldLostFocus" />
                                    </Grid>
                                    <TextBlock Classes="label" Text="BAR TEXTURE" />
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                                        <TextBox Grid.Column="0" Text="{Binding StatusBarTextureDraft, Mode=TwoWay}"
                                                 Tag="statusBarTexture" IsEnabled="{Binding CanEditDesignStatusBar}"
                                                 KeyDown="OnStatusBarFieldKeyDown" LostFocus="OnStatusBarFieldLostFocus"
                                                 ToolTip.Tip="A project-owned asset (e.g. assets\\hunt_bar.png) that is persisted in the project, or a WoW reference (e.g. Interface\\TargetingFrame\\UI-StatusBar) that resolves against your WoW client. Machine paths are never stored." />
                                        <Button Grid.Column="1" Content="Artwork…" IsEnabled="{Binding CanEditDesignStatusBar}"
                                                Click="OnBrowseNewStatusBarTextureClick"
                                                ToolTip.Tip="Pick an image from your machine; it is copied into the project so the project stays portable." />
                                        <Button Grid.Column="2" Content="WoW Client…" IsEnabled="{Binding CanEditDesignStatusBar}"
                                                Click="OnBrowseWowStatusBarTextureClick"
                                                ToolTip.Tip="Choose stock WoW Interface art as a logical reference; no machine path is saved." />
                                    </Grid>
                                    <TextBlock Classes="mono" Text="{Binding SelectedStatusBarTexturePhysical}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Classes="label" Text="BAR COLOR" />
                                    <Grid ColumnDefinitions="72,*" ColumnSpacing="6" IsEnabled="{Binding CanEditRuntimeBinding}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Border Width="20" Height="14" BorderBrush="#8FA6B4" BorderThickness="1"
                                                    Background="{Binding SelectedStatusBarColorSwatch}" />
                                            <TextBlock Classes="label" Text="RGBA" />
                                        </StackPanel>
                                        <TextBox Grid.Column="1" Text="{Binding StatusBarColorDraft, Mode=TwoWay}"
                                                 Tag="statusBarColor" IsEnabled="{Binding CanEditDesignStatusBar}"
                                                 KeyDown="OnStatusBarFieldKeyDown" LostFocus="OnStatusBarFieldLostFocus"
                                                 PlaceholderText="#RRGGBB or #AARRGGBB" />
                                    </Grid>
                                    <TextBlock Classes="validation" Text="{Binding StatusBarValidation}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel IsVisible="{Binding IsRuntimeBindingEligible}" Spacing="3" Margin="0,7,0,0">
                                    <TextBlock Classes="label" Text="RUNTIME BINDING" />
                                    <CheckBox Content="Runtime value"
                                              IsChecked="{Binding RuntimeValueRequiredDraft, Mode=OneWay}"
                                              IsEnabled="{Binding CanEditRuntimeBinding}"
                                              Click="OnRuntimeValueRequiredClick" />
                                    <Grid ColumnDefinitions="72,*" ColumnSpacing="6">
                                        <TextBlock Classes="label" Text="Binding Key" />
                                        <TextBox Grid.Column="1" Text="{Binding RuntimeBindingDraft, Mode=TwoWay}"
                                                 IsEnabled="{Binding RuntimeValueRequiredDraft}"
                                                 KeyDown="OnRuntimeBindingKeyDown"
                                                 LostFocus="OnRuntimeBindingLostFocus"
                                                 PlaceholderText="hunt.targetName" />
                                    </Grid>
                                    <TextBlock Classes="label" Text="{Binding RuntimeBindingOperationSummary}" TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="72,*" ColumnSpacing="6" IsVisible="{Binding HasFunctionalExport}">
                                        <TextBlock Classes="label" Text="Optional mirror" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding FunctionalValueSourceOptions}"
                                                  SelectedItem="{Binding SelectedFunctionalValueSource, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanMapFunctionalValue}"
                                                  PlaceholderText="Module Lua may populate directly" />
                                    </Grid>
                                    <TextBlock Classes="label" Text="{Binding FunctionalExportSummary}"
                                               IsVisible="{Binding HasFunctionalExport}" TextWrapping="Wrap" />
                                    <TextBlock Classes="validation" Text="{Binding RuntimeBindingValidation}" TextWrapping="Wrap" />
                                </StackPanel>
                                <CheckBox Content="Locked" IsChecked="{Binding SelectedElementLocked, Mode=TwoWay}" />
                                <StackPanel Spacing="3" Margin="0,5,0,0" IsVisible="{Binding CanChangeDesignOrder}">
                                    <TextBlock Classes="label" Text="DRAW ORDER" />
                                    <WrapPanel>
                                        <Button Content="Bring to Front" Click="OnBringToFrontClick" Margin="0,0,4,4" />
                                        <Button Content="Bring Forward" Click="OnBringForwardClick" Margin="0,0,4,4" />
                                        <Button Content="Send Backward" Click="OnSendBackwardClick" Margin="0,0,4,4" />
                                        <Button Content="Send to Back" Click="OnSendToBackClick" Margin="0,0,4,4" />
                                    </WrapPanel>
                                    <TextBlock Classes="label" Text="DESIGN tree: bottom item is front. Locked Blizzard content remains the foundation."
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel IsVisible="{Binding IsStockFrameworkSelected}" Spacing="4" Margin="0,5,0,0">
                                    <Button Content="Expand / inspect components" Click="OnExpandStockClick" />
                                    <Button Content="Collapse components" Click="OnCollapseStockClick" />
                                    <Button Content="{Binding StockFrameworkAction}" Click="OnStockLockActionClick" />
                                    <TextBlock Classes="label" Text="Expansion changes tree presentation only; locking controls editability."
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        </StackPanel>

                        <Border Background="#101D25" BorderBrush="#315268" BorderThickness="1"
                                CornerRadius="4" Padding="8,6" IsVisible="{Binding IsInspectWorkspace}">
                            <StackPanel Spacing="3">
                                <TextBlock Classes="header" Text="SOURCE / PROVENANCE" Margin="0,0,0,3" />
                                <TextBlock Classes="value" Text="{Binding Editor.Name}" TextWrapping="Wrap" />
                                <TextBlock Classes="mono" Text="{Binding SelectedElementKind, StringFormat='Kind: {0}'}" />
                                <TextBlock Classes="mono" Text="{Binding SelectedOrigin, StringFormat='Origin: {0}'}" TextWrapping="Wrap" />
                                <TextBlock Classes="mono" Text="{Binding SelectedSourceFile, StringFormat='Source: {0}'}" TextWrapping="Wrap" />
                                <TextBlock Classes="mono" Text="{Binding SelectedSourcePath}" TextWrapping="Wrap"
                                           ToolTip.Tip="{Binding SelectedSourcePath}" />
                                <TextBlock Classes="mono" Text="{Binding SelectedSourceLocation}" />
                                <TextBlock Classes="mono" Text="{Binding SelectedParentName, StringFormat='Parent: {0}'}" TextWrapping="Wrap" />
                                <TextBlock Classes="mono" Text="{Binding SelectedInheritance, StringFormat='Inherits: {0}'}" TextWrapping="Wrap" />
                                <TextBlock Classes="mono" Text="{Binding SelectedPreviewProvenance}" TextWrapping="Wrap" />
                                <TextBlock Classes="mono" Text="{Binding SelectedGroupMembership, StringFormat='Groups: {0}'}" TextWrapping="Wrap" />
                                <StackPanel IsVisible="{Binding IsDesignTextSelected}" Spacing="2" Margin="0,5,0,0">
                                    <TextBlock Classes="label" Text="TEXT IDENTITY" />
                                    <TextBlock Classes="mono" Text="{Binding SelectedSourceText, StringFormat='Source/imported text: {0}'}" TextWrapping="Wrap" />
                                    <TextBlock Classes="mono" Text="{Binding SelectedDesignTextOverride, StringFormat='Design override text: {0}'}" TextWrapping="Wrap" />
                                    <TextBlock Classes="mono" Text="{Binding SelectedTextBaseStyle, StringFormat='Base WoW style: {0}'}" TextWrapping="Wrap" />
                                    <TextBlock Classes="mono" Text="{Binding SelectedTextFont, StringFormat='Effective font: {0}'}" TextWrapping="Wrap" />
                                    <TextBlock Classes="mono" Text="{Binding SelectedTextEffectiveSize, StringFormat='Effective size: {0}'}" />
                                    <TextBlock Classes="mono" Text="{Binding SelectedTextEffectiveColor, StringFormat='Effective color: {0}'}" />
                                    <TextBlock Classes="mono" Text="{Binding SelectedTextOverrides, StringFormat='DESIGN overrides: {0}'}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel IsVisible="{Binding IsDesignImageSelected}" Spacing="2" Margin="0,5,0,0">
                                    <TextBlock Classes="label" Text="DESIGN ASSET" />
                                    <TextBlock Classes="mono" Text="{Binding SelectedDesignAssetReference, StringFormat='Design asset: {0}'}" TextWrapping="Wrap" />
                                    <TextBlock Classes="mono" Text="{Binding SelectedDesignAssetPhysicalPath, StringFormat='Physical path: {0}'}" TextWrapping="Wrap" />
                                    <TextBlock Classes="mono" Text="{Binding SelectedDesignAssetDimensions, StringFormat='Dimensions: {0}'}" />
                                    <TextBlock Classes="mono" Text="{Binding SelectedDesignAssetFormat, StringFormat='Source format: {0}'}" />
                                    <TextBlock Classes="mono" Text="{Binding SelectedDesignAssetOwnership, StringFormat='Ownership: {0}'}" />
                                    <TextBlock Classes="mono" Text="{Binding SelectedDesignAssetDiagnostic}" TextWrapping="Wrap" />
                                    <TextBlock Classes="mono" Text="{Binding SelectedWowExportReference, StringFormat='WoW export texture: {0}'}" TextWrapping="Wrap" />
                                </StackPanel>
                                <CheckBox Content="Lock this element"
                                          IsChecked="{Binding SelectedElementLocked, Mode=TwoWay}" />
                                <TextBlock Classes="label" Text="Locked by an element or group; geometry editing is disabled."
                                           IsVisible="{Binding IsSelectionLocked}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Provenance, above the editable fields and outside their enabled state:
                             it describes the source, so it stays true while the fields below are
                             read-only because the frame belongs to an imported document. -->
                        <Border Background="#151B21" CornerRadius="4" Padding="8,6" Margin="0,0,0,8"
                                IsVisible="{Binding IsInspectWorkspace}">
                            <TextBlock Classes="mono" TextWrapping="Wrap"
                                       Text="{Binding Editor.SourceNote}" Opacity="0.85" />
                        </Border>

                        <Expander Header="POSITION · SIZE · ANCHOR · APPEARANCE"
                                 IsExpanded="{Binding IsDesignWorkspace}"
                                 IsVisible="{Binding ShowsSingleObjectEditors}">
                        <StackPanel Spacing="2" IsEnabled="{Binding CanEditSelection}" Margin="0,6,0,0">
                        <Grid ColumnDefinitions="96,*" IsVisible="{Binding IsInspectWorkspace}">
                            <TextBlock Grid.Column="0" Classes="label" Text="Name" />
                            <TextBox Grid.Column="1" Text="{Binding Editor.Name, Mode=TwoWay}" Margin="4,0,0,4"
                                     IsEnabled="{Binding CanEditLayoutStructure}"
                                     Tag="name" KeyDown="OnBufferedEditorKeyDown" LostFocus="OnBufferedEditorLostFocus" />
                        </Grid>

                        <Grid ColumnDefinitions="96,*">
                            <TextBlock Grid.Column="0" Classes="label" Text="Parent" />
                            <ComboBox Grid.Column="1" Margin="4,0,0,4"
                                      IsEnabled="{Binding CanEditLayoutStructure}"
                                      ItemsSource="{Binding Editor.FrameOptions}"
                                      SelectedItem="{Binding Editor.Parent, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnDefinitions="96,*">
                            <TextBlock Grid.Column="0" Classes="label" Text="Width" />
                            <TextBox Grid.Column="1" Margin="4,0,0,4" Text="{Binding Editor.Width, Mode=TwoWay}"
                                     Tag="width" KeyDown="OnBufferedEditorKeyDown" LostFocus="OnBufferedEditorLostFocus" />
                        </Grid>

                        <Grid ColumnDefinitions="96,*">
                            <TextBlock Grid.Column="0" Classes="label" Text="Height" />
                            <TextBox Grid.Column="1" Margin="4,0,0,4" Text="{Binding Editor.Height, Mode=TwoWay}"
                                     Tag="height" KeyDown="OnBufferedEditorKeyDown" LostFocus="OnBufferedEditorLostFocus" />
                        </Grid>

                        <Grid ColumnDefinitions="96,*">
                            <TextBlock Grid.Column="0" Classes="label" Text="Size ref" />
                            <ComboBox Grid.Column="1" Margin="4,0,0,4"
                                      IsEnabled="{Binding CanEditLayoutStructure}"
                                      ItemsSource="{Binding Editor.SizeReferenceOptions}"
                                      SelectedItem="{Binding Editor.SizeReference, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnDefinitions="96,*">
                            <TextBlock Grid.Column="0" Classes="label" Text="Point" />
                            <ComboBox Grid.Column="1" Margin="4,0,0,4"
                                      IsEnabled="{Binding CanEditLayoutStructure}"
                                      ItemsSource="{Binding Editor.AnchorOptions}"
                                      SelectedItem="{Binding Editor.Point, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnDefinitions="96,*">
                            <TextBlock Grid.Column="0" Classes="label" Text="Relative to" />
                            <ComboBox Grid.Column="1" Margin="4,0,0,4"
                                      IsEnabled="{Binding CanEditLayoutStructure}"
                                      ItemsSource="{Binding Editor.FrameOptions}"
                                      SelectedItem="{Binding Editor.RelativeTo, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnDefinitions="96,*">
                            <TextBlock Grid.Column="0" Classes="label" Text="Relative pt" />
                            <ComboBox Grid.Column="1" Margin="4,0,0,4"
                                      IsEnabled="{Binding CanEditLayoutStructure}"
                                      ItemsSource="{Binding Editor.AnchorOptions}"
                                      SelectedItem="{Binding Editor.RelativePoint, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnDefinitions="96,*">
                            <TextBlock Grid.Column="0" Classes="label" Text="Offset X" />
                            <TextBox Grid.Column="1" Margin="4,0,0,4" Text="{Binding Editor.OffsetX, Mode=TwoWay}"
                                     Tag="offsetX" KeyDown="OnBufferedEditorKeyDown" LostFocus="OnBufferedEditorLostFocus" />
                        </Grid>

                        <Grid ColumnDefinitions="96,*">
                            <TextBlock Grid.Column="0" Classes="label" Text="Offset Y" />
                            <TextBox Grid.Column="1" Margin="4,0,0,4" Text="{Binding Editor.OffsetY, Mode=TwoWay}"
                                     Tag="offsetY" KeyDown="OnBufferedEditorKeyDown" LostFocus="OnBufferedEditorLostFocus" />
                        </Grid>

                        <CheckBox Margin="4,4,0,4" Content="Visible" IsChecked="{Binding Editor.IsVisible, Mode=TwoWay}"
                                  IsEnabled="{Binding CanEditLayoutStructure}" />
                        <TextBlock Classes="label" Foreground="#E06C6C" Text="{Binding Editor.ValidationMessage}"
                                   TextWrapping="Wrap" Margin="4,2,0,4" />
                        <TextBlock Classes="label" Foreground="#E5B567" Text="{Binding SelectedGeometryEditDiagnostic}"
                                   TextWrapping="Wrap" Margin="4,2,0,4" />
                        </StackPanel>
                        </Expander>

                        <TextBlock Classes="header" Text="RESOLVED GEOMETRY" Margin="0,12,0,4" IsVisible="{Binding IsInspectWorkspace}" />
                        <TextBlock Classes="mono" Text="{Binding Editor.ResolvedSummary}" TextWrapping="Wrap" IsVisible="{Binding IsInspectWorkspace}" />

                        <!-- Extra anchors are shown, not editable. WoW applies several anchors
                             together and FrameForge will not rewrite one blind, so displaying them
                             is the honest option; hiding them would lose the only record of what
                             the source actually asked for. -->
                        <StackPanel IsVisible="{Binding IsInspectWorkspace}" Margin="0,10,0,0">
                            <TextBlock Classes="header" Text="ADDITIONAL ANCHORS (READ-ONLY)" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding Editor.ExtraAnchors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:AnchorLine">
                                        <Border BorderBrush="#22303A" BorderThickness="1" CornerRadius="3"
                                                Padding="6,4" Margin="0,0,0,4">
                                            <StackPanel Spacing="1">
                                                <TextBlock Classes="mono" Text="{Binding Label}" />
                                                <TextBlock Classes="mono" TextWrapping="Wrap"
                                                           Text="{Binding Point}" Opacity="0.9" />
                                                <TextBlock Classes="mono" TextWrapping="Wrap"
                                                           Text="{Binding Target}" Opacity="0.9" />
                                                <TextBlock Classes="mono" TextWrapping="Wrap"
                                                           Text="{Binding RelativePoint}" Opacity="0.9" />
                                                <TextBlock Classes="mono" TextWrapping="Wrap"
                                                           Text="{Binding Offsets}" Opacity="0.7" />
                                                <TextBlock Classes="mono" TextWrapping="Wrap"
                                                           Text="{Binding Note}" Opacity="0.7" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsInspectWorkspace}" Margin="0,14,0,0">
                            <TextBlock Classes="header" Text="VISUAL COMPOSITION" Margin="0,0,0,4" />
                            <TextBlock Classes="mono" Text="{Binding CompositionSizeSource, StringFormat='Size controlled by: {0}'}"
                                       TextWrapping="Wrap" Margin="0,0,0,3" />
                            <TextBlock Classes="mono" Text="{Binding CompositionAppearanceSource, StringFormat='Appearance provided by: {0}'}"
                                       TextWrapping="Wrap" Margin="0,0,0,5" />
                            <ItemsControl ItemsSource="{Binding VisualComposition}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#141B22" BorderBrush="#22303A" BorderThickness="1"
                                                CornerRadius="4" Padding="7,5" Margin="0,0,0,5">
                                            <StackPanel Spacing="2">
                                                <Button HorizontalAlignment="Left" Padding="4,1"
                                                        Content="{Binding Heading}" Tag="{Binding FrameName}"
                                                        Click="OnSelectCompositionClick"
                                                        ToolTip.Tip="Select this visual component" />
                                                <TextBlock Classes="mono" Text="{Binding Origin}" TextWrapping="Wrap" />
                                                <TextBlock Classes="mono" Text="{Binding AssetPath}" TextWrapping="Wrap" />
                                                <TextBlock Classes="mono" Text="{Binding Resolution}" TextWrapping="Wrap" />
                                                <TextBlock Classes="mono" Text="{Binding Geometry}" TextWrapping="Wrap" />
                                                <TextBlock Classes="mono" Text="{Binding Details}" TextWrapping="Wrap" Opacity="0.8" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Background="#242016" BorderBrush="#69592F" BorderThickness="1"
                                    CornerRadius="4" Padding="7,5" Margin="0,3,0,0">
                                <TextBlock Classes="mono" Text="{Binding ResizeGuidance}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>

                        <TextBlock Classes="mono" TextWrapping="Wrap" Margin="0,8,0,0" IsVisible="{Binding IsInspectWorkspace}"
                                   Text="{Binding Editor.AnchorNote}" Foreground="#E06C6C" />

                        <!--
                            Retained visual metadata. Read-only on purpose, and stated as such:
                            FrameForge understands these values and can draw a stand-in for them, but
                            it does not decode the art, emulate the Blizzard fonts, or run the Lua
                            that assigns runtime text. Showing the declared values without claiming
                            more is the honest presentation - an inspector that rendered the texture
                            file as if it were the texture would be lying about what it can do.
                        -->
                        <StackPanel IsVisible="{Binding IsInspectWorkspace}" Margin="0,14,0,0">
                            <TextBlock Classes="header" Text="DECLARED VISUALS (READ-ONLY)" Margin="0,0,0,4" />
                            <Border Background="#141B22" BorderBrush="#22303A" BorderThickness="1"
                                    CornerRadius="4" Padding="8,6">
                                <ItemsControl ItemsSource="{Binding Editor.VisualLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Classes="mono" Text="{Binding}" TextWrapping="Wrap"
                                                       Margin="0,1" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>

                        <TextBlock Classes="label" Margin="0,8,0,0" Text="WoW model units, +Y up" />
                    </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Geometry diagnostics -->
        <Border Grid.Row="4" Background="#0D141A" BorderBrush="#22303A" BorderThickness="0,1,0,0" Padding="10,6">
            <StackPanel Spacing="2">
                <TextBlock Classes="value" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="mono" Text="{Binding SelectionSummary}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
