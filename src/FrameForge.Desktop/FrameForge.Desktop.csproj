<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>FrameForge.Desktop</RootNamespace>
    <AssemblyName>FrameForge</AssemblyName>
    <Product>FrameForge</Product>
    <Description>Visual layout editor for World of Warcraft 3.3.5a user interfaces.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\branding\frameforge-icon.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!--
      Avalonia is compiled ahead of time and relies on reflection for XAML and for Skia
      native loading, so self-contained publishes must not be trimmed.
    -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- Link the single derived PNG into the assembly so the window icon is independent
         of the current directory and of the installed file layout. -->
    <AvaloniaResource Include="..\..\assets\branding\frameforge-icon.png"
                      Link="Assets/Branding/frameforge-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Pure-managed, read-only use behind IWoWArchiveReader; no native MPQ runtime is shipped. -->
    <PackageReference Include="Nmpq.Standard" Version="1.0.0" />
    <PackageReference Include="War3Net.IO.Mpq" Version="6.0.3" />
    <!-- Used directly for authoritative local TTF metrics; already part of Avalonia's render stack. -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!--
      The dependency direction is one way: Desktop depends on Core, never the reverse.
      FrameForge.Core holds the WoW geometry engine and has no Avalonia reference.
    -->
    <ProjectReference Include="..\FrameForge.Core\FrameForge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shipped example ships with the app so "Load Native Hunts Example" always works. -->
    <AvaloniaResource Include="..\..\examples\native-hunts.fforge.json"
                      Link="Assets/examples/native-hunts.fforge.json" />

    <!--
      The real NativeHuntsFrame.xml is packaged so the desktop smoke test can exercise the
      FrameXML importer end to end, including in a self-contained publish where the repository
      is not present. It is LINKED from the single canonical copy in the test fixtures folder
      rather than duplicated, so the importer can never be smoke-tested against a stale copy.
    -->
    <AvaloniaResource Include="..\..\tests\FrameForge.Core.Tests\Fixtures\NativeHuntsFrame.xml"
                      Link="Assets/Fixtures/NativeHuntsFrame.xml" />
  </ItemGroup>

</Project>
